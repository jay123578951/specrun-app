{
  "name": "specrun-app",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:app": "tauri dev",
    "dev:api": "nitro dev --port 3210",
    "dev:web": "vite",
    "build": "vite build && nitro build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "nitro prepare && vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@ibm/plex-sans-tc": "^1.1.1",
    "@tauri-apps/api": "^2.11.1",
    "markdown-it": "^15.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "pinia": "^4.0.3",
    "shiki": "^4.4.3",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@iconify-json/lucide": "^1.2.123",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "nitropack": "^2.13.4",
    "typescript": "^5.9.3",
    "unocss": "^66.7.5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
