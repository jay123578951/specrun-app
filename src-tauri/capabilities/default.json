{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "main 視窗權限：fs 各操作，靜態 scope 僅共用設定目錄 $CONFIG/specrun-app；專案路徑由 allow_path 於 runtime 授權；opener 外掛負責在檔案管理器中選取項目與開啟外部網址",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-read-dir",
    "fs:allow-watch",
    "fs:allow-unwatch",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$CONFIG/specrun-app" },
        { "path": "$CONFIG/specrun-app/**" }
      ]
    }
  ]
}
