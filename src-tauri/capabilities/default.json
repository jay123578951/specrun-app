{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "main 視窗權限：fs 各操作，靜態 scope 僅 $APPDATA；專案路徑由 allow_path 於 runtime 授權",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-read-dir",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA" },
        { "path": "$APPDATA/**" }
      ]
    }
  ]
}
